
import random
import math

# City coordinates
cities = [
    (0, 0),
    (2, 3),
    (5, 2),
    (6, 6),
    (8, 3)
]

n = len(cities)

# ACO parameters
ants = 10
iterations = 50
alpha = 1
beta = 2
rho = 0.5
Q = 100

# Calculate distances
distance = [[0]*n for _ in range(n)]

for i in range(n):
    for j in range(n):
        distance[i][j] = math.dist(
            cities[i], cities[j]
        )

# Initialize pheromone trails
pheromone = [
    [1.0]*n for _ in range(n)
]

def route_length(route):
    total = 0

    for i in range(n):
        a = route[i]
        b = route[(i+1) % n]
        total += distance[a][b]

    return total

best_route = None
best_distance = float("inf")

# ACO optimization
for iteration in range(iterations):

    all_routes = []

    for ant in range(ants):

        start = random.randrange(n)
        route = [start]
        unvisited = list(range(n))
        unvisited.remove(start)

        while unvisited:

            current = route[-1]
            probabilities = []

            for city in unvisited:
                pher = pheromone[current][city] ** alpha
                heuristic = (
                    1 / distance[current][city]
                ) ** beta

                probabilities.append(pher * heuristic)

            total = sum(probabilities)

            if total == 0:
                next_city = random.choice(unvisited)
            else:
                probabilities = [
                    p / total for p in probabilities
                ]

                next_city = random.choices(
                    unvisited,
                    weights=probabilities
                )[0]

            route.append(next_city)
            unvisited.remove(next_city)

        length = route_length(route)
        all_routes.append((route, length))

        if length < best_distance:
            best_distance = length
            best_route = route[:]

    # Pheromone evaporation
    for i in range(n):
        for j in range(n):
            pheromone[i][j] *= (1 - rho)

    # Pheromone update
    for route, length in all_routes:

        deposit = Q / length

        for i in range(n):
            a = route[i]
            b = route[(i+1) % n]

            pheromone[a][b] += deposit
            pheromone[b][a] += deposit

# Display result
print("ANT COLONY OPTIMIZATION")
print("-----------------------")
print("Best Route:")

print(" -> ".join(str(x+1) for x in best_route),
      "->", best_route[0]+1)

print("Shortest Distance:", round(best_distance, 4))
print("Total Cities:", n)
print("Iterations:", iterations)

