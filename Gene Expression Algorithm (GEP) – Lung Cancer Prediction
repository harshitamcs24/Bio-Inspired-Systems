
import random
import math

# Illustrative gene-expression dataset
# Three features and one class label
data = [
    [8, 7, 9, 1],
    [9, 8, 8, 1],
    [7, 9, 8, 1],
    [2, 3, 2, 0],
    [3, 2, 4, 0],
    [1, 2, 3, 0],
    [8, 6, 9, 1],
    [2, 4, 3, 0]
]

# Each chromosome represents an expression rule
population_size = 20
generations = 30

def generate_chromosome():
    return [
        random.randint(0, 2),
        random.randint(0, 2),
        random.randint(0, 2)
    ]

population = [
    generate_chromosome()
    for _ in range(population_size)
]

def predict(chromosome, row):
    score = sum(
        chromosome[i] * row[i]
        for i in range(3)
    )

    return 1 if score >= 15 else 0

def fitness(chromosome):
    correct = 0

    for row in data:
        prediction = predict(chromosome, row)

        if prediction == row[3]:
            correct += 1

    return correct / len(data)

# Evolution process
for generation in range(generations):

    population.sort(
        key=fitness,
        reverse=True
    )

    new_population = population[:4]

    while len(new_population) < population_size:

        parent1 = random.choice(population[:10])
        parent2 = random.choice(population[:10])

        # Crossover
        point = random.randint(1, 2)

        child = (
            parent1[:point] +
            parent2[point:]
        )

        # Mutation
        if random.random() < 0.2:
            position = random.randint(0, 2)
            child[position] = random.randint(0, 2)

        new_population.append(child)

    population = new_population

# Best solution
best = max(population, key=fitness)

print("GENE EXPRESSION ALGORITHM")
print("-------------------------")
print("Best Chromosome:", best)
print("Best Fitness:", round(fitness(best), 4))
print("Training Accuracy:", round(fitness(best) * 100, 2), "%")

print("Best Expression Rule:")
print(best[0], "* Gene1 +",
      best[1], "* Gene2 +",
      best[2], "* Gene3")

print("Optimization Completed!")
